NODE_ENV=development
# Render injects PORT itself in production — this default is for local dev only.
PORT=4000
# Origin of the deployed web app. In production, set this to the web app's
# real URL (e.g. https://your-app.onrender.com).
CORS_ORIGIN="http://localhost:3002"
DATABASE_URL="postgresql://nadar:nadar_dev_password@localhost:5439/nadar_kalyanam"
REDIS_URL="redis://localhost:6380"
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000
JWT_ACCESS_TOKEN_SECRET="change-me-in-every-environment"
# Object storage — local dev points at docker-compose's MinIO. In production,
# point these at a managed S3-compatible provider (Cloudflare R2, AWS S3,
# Backblaze B2, DigitalOcean Spaces, etc). MINIO_* names are kept because the
# client code is generic — any S3-compatible provider's endpoint/keys/bucket
# fit these same fields.
MINIO_ENDPOINT="http://localhost:9002"
MINIO_ACCESS_KEY="nadar_minio"
MINIO_SECRET_KEY="nadar_minio_password"
MINIO_BUCKET_NAME="nadar-kalyanam-photos"
# true for MinIO and most S3-compatible providers (path-style URLs). Set to
# false for real AWS S3 (virtual-hosted-style).
STORAGE_FORCE_PATH_STYLE=true
# Arbitrary for MinIO/most S3-compatible providers. Must match the bucket's
# real region for AWS S3, or request signing fails.
STORAGE_REGION="us-east-1"
# Optional: override the public URL objects are read from (a provider's
# public bucket domain or a CDN). Required when STORAGE_FORCE_PATH_STYLE is
# false, since the path-style fallback URL won't resolve in that case.
# STORAGE_PUBLIC_URL="https://your-bucket.s3.amazonaws.com"

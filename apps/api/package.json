{
  "name": "@nadar-kalyanam/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:seed:demo": "tsx --env-file-if-exists=.env prisma/seed-demo.ts",
    "profiles:backfill-completion": "tsx --env-file-if-exists=.env prisma/backfill-completion-scores.ts",
    "dev:trial": "tsx --env-file-if-exists=.env prisma/dev-trial.ts",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@nadar-kalyanam/schemas": "workspace:*",
    "@nestjs/common": "^11.2.9",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.9",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/platform-socket.io": "^11.2.9",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.2.9",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.10.1",
    "astronomy-engine": "2.1.19",
    "bullmq": "^6.3.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.2",
    "nestjs-pino": "^4.4.0",
    "pdfkit": "^0.20.2",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@nestjs/cli": "^11.0.24",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.6",
    "eslint": "^9.15.0",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^4.1.12"
  }
}

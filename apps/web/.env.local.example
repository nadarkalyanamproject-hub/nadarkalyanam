NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
# In production, set to the deployed API's URL (e.g.
# https://your-api.onrender.com/api/v1). Note: NEXT_PUBLIC_* vars are baked
# into the client bundle at build time — set this before running `next build`.
# Where to send a user whose login resolves to an admin-scoped token (see
# app/page.tsx's handleLoginOtp) — the admin app's own URL, not this app's.
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
